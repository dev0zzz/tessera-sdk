{
  "name": "@tesseraat/sdk",
  "version": "0.9.2",
  "description": "Shared integration layer for Tessera apps: OIDC relying-party (id.tessera.at) and PDS helpers",
  "license": "MIT",
  "repository": "github:dev0zzz/tessera-sdk",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./oidc-rp": {
      "types": "./dist/oidc-rp/index.d.ts",
      "default": "./dist/oidc-rp/index.js"
    },
    "./eudi": {
      "types": "./dist/eudi/index.d.ts",
      "default": "./dist/eudi/index.js"
    },
    "./orgs": {
      "types": "./dist/orgs/index.d.ts",
      "default": "./dist/orgs/index.js"
    },
    "./flairs": {
      "types": "./dist/flairs/index.d.ts",
      "default": "./dist/flairs/index.js"
    },
    "./auth-browser": {
      "types": "./dist/auth-browser/index.d.ts",
      "default": "./dist/auth-browser/index.js"
    },
    "./auth-node": {
      "types": "./dist/auth-node/index.d.ts",
      "default": "./dist/auth-node/index.js"
    },
    "./zaps": {
      "types": "./dist/zaps/index.d.ts",
      "default": "./dist/zaps/index.js"
    },
    "./zaps/element": {
      "types": "./dist/zaps/element.d.ts",
      "default": "./dist/zaps/element.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@atproto/api": "^0.20.28",
    "@atproto/oauth-client-browser": "^0.4.8",
    "@atproto/oauth-client-node": "^0.4.8",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "better-sqlite3": "^12.11.1",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "@atproto/api": ">=0.20.0",
    "@atproto/oauth-client-browser": ">=0.4.0",
    "@atproto/oauth-client-node": ">=0.4.0",
    "better-sqlite3": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "@atproto/api": {
      "optional": true
    },
    "@atproto/oauth-client-browser": {
      "optional": true
    },
    "@atproto/oauth-client-node": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  },
  "dependencies": {
    "@sd-jwt/sd-jwt-vc": "0.20.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
