{
  "lexicon": 1,
  "id": "at.tessera.agent.createSession",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Exchange an agent service token for a short-lived session.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["token"],
          "properties": { "token": { "type": "string" } }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did", "handle", "accessJwt", "refreshJwt"],
          "properties": {
            "did": { "type": "string", "format": "did" },
            "handle": { "type": "string", "format": "handle" },
            "accessJwt": { "type": "string" },
            "refreshJwt": { "type": "string" }
          }
        }
      },
      "errors": [{ "name": "InvalidToken" }]
    }
  }
}
